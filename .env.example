# Базовый URL GREEN-API: используется как baseURL для всех запросов к API (без префикса /v3)
VITE_API_URL=https://4100.api.green-api.com/
# Таймаут ожидания уведомления в секундах для HTTP API (GREEN-API принимает от 5 до 60)
VITE_RECEIVE_TIMEOUT=5
# отображение панелей и информации отладки
VITE_DEVTOOLS_ENABLED=true
